ErrorDocument 404 /404.html

# ---------- Always HTTPS, always www (matches the canonical URLs) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.mariana-marcelino.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^mariana-marcelino\.com$ [NC]
  RewriteRule ^ https://www.mariana-marcelino.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- Security headers ----------
# The CSP only lets the site load its own files, Calendly (booking popup) and
# FormSubmit (forms). The two sha256 values are the two small inline scripts in
# every page's <head>: if either script changes, its hash must be updated here.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-FzEKlawfsy0A74vKt6TMeioz5FtUGrXgBw2GLj6+NJ8=' 'sha256-Fm5N84qQTViBtIz/JedWhYeYLCBABUQCD3QLK7yX+zc=' https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://assets.calendly.com; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://formsubmit.co; frame-src https://calendly.com; form-action 'self' https://formsubmit.co; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Build scripts and private files are not served
<FilesMatch "\.(py|md|sh|log|bak)$">
  Require all denied
</FilesMatch>
# Design explorations and the guide's print sources aren't part of the site
RedirectMatch 404 ^/(versions/|preview-v1\.html|package(-lock)?\.json|guide/.*\.html)

# ---------- File types ----------
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest

# ---------- Compression (text files shrink to roughly a quarter) ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript text/javascript application/json application/ld+json application/manifest+json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/ld+json application/manifest+json application/xml image/svg+xml
</IfModule>

# ---------- Browser caching ----------
# CSS and JS are referenced with ?v=… and fonts never change, so they can be
# cached for a year; images for a month; pages are always revalidated so
# visitors get new content straight away.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
